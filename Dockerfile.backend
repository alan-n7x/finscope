# ============================================================================
# Estágio 1: build do frontend (React + Vite -> arquivos estáticos em /dist)
# Descartado ao final; só o dist pronto segue para a imagem de produção.
# ============================================================================
FROM node:22-slim AS frontend-build

WORKDIR /web

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build


# ============================================================================
# Estágio 2: backend FastAPI servindo API + frontend estático na porta 8000
# (app/main.py monta frontend/dist e responde o SPA em qualquer rota)
# ============================================================================
FROM python:3.14-slim-bookworm

WORKDIR /app

# Instala dependências de compilação para asyncpg/psycopg2
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Instala o gerenciador UV da Astral
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Copia manifestos de dependências
COPY pyproject.toml uv.lock* ./

# Instala dependências em cache
RUN uv sync --frozen --no-cache

# Copia código da aplicação (o .dockerignore barra .venv, .git, node_modules etc.)
COPY . .

# Garante o frontend recém-compilado (ignora qualquer dist antigo local)
COPY --from=frontend-build /web/dist ./frontend/dist

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
